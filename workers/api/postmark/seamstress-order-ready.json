{
  "alias": "seamstress-order-ready",
  "name": "Seamless: order ready",
  "subject": "{{orderNumber}} is ready for collection",
  "html": "<!doctype html>\n<html lang=\"en\"><body style=\"margin:0;background:#FBF6F4;font-family:Inter,Arial,sans-serif;color:#2B1B33\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FBF6F4\"><tr><td align=\"center\" style=\"padding:0\">\n<div style=\"height:12px;background:#2B1B33\"></div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px\"><tr><td style=\"padding:24px 20px\">\n<p style=\"margin:0 0 16px;font-family:Georgia,serif;font-style:italic;font-size:22px;color:#7A2E4D\">{{atelierName}}</p>\n<h1 style=\"margin:0 0 8px;font-family:Georgia,serif;font-size:26px;line-height:1.2\">Ready for you</h1>\n<p style=\"margin:0 0 20px;font-family:Georgia,serif;font-style:italic;color:#7A2E4D\">Pressed, checked and waiting, {{clientName}}.</p>\n<div style=\"background:#fff;border:1px solid #E8DCD9;border-radius:6px;padding:16px;font-size:16px;line-height:1.5\"><p style=\"margin:0 0 8px\"><strong>{{orderNumber}}</strong> is finished and ready to collect from {{atelierName}}.</p><p style=\"margin:0\">Reply to this email to arrange a time.</p></div>\n<p style=\"margin:20px 0\"><a href=\"{{trackingUrl}}\" style=\"display:block;text-align:center;background:#7A2E4D;color:#fff;font-weight:600;text-decoration:none;border-radius:4px;padding:14px\">See the finished work</a></p>\n<p style=\"margin:20px 0 0;font-size:13px;color:#6A5870\">Sent by Seamless for {{atelierName}}. Just reply to this email to reach them.</p>\n</td></tr></table></td></tr></table></body></html>",
  "text": "Hello {{clientName}},\n\n{{orderNumber}} is finished and ready to collect from {{atelierName}}.\n\nSee the finished work: {{trackingUrl}}\n\nReply to this email to arrange a time."
}
